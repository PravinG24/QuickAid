{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionHost": {
    "cors": {
      "supportCredentials": false,
      "allowedOrigins": [
        "https://portal.azure.com",
        "https://ms.portal.azure.com",
        "https://quickaid-frontend.azurewebsites.net",
        "http://localhost:3000",
        "http://localhost:5500"
      ]
    }
  }
}
